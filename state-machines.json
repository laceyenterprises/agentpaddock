  "dispositions": [
    {
      "field": "grader.Cell.outcome; outcomes.OUTCOMES/PASSING; taint.GATE_OUTCOMES",
      "owner": "tools/paddock",
      "disposition": "owned",
      "reason": "Terminal per-cell decisions include gating outcomes, not green skips. Grader mutation sites include _grade, _grade_with_audit and suite level/model/price checks; exact predicates are independently inventoried."
    },
    {
      "field": "lease state; lease.cells admissions/bindings/accounting; endpoint_results finalization",
      "owner": "tools/paddock",
      "disposition": "owned",
      "reason": "Manager owns lease JSON and save/load/audit. Creating/warming have inline deadline checks; ready/closing require a caller/reaper. No mandatory background lifetime enforcer, enforcement=missing; proposed periodic reaper within 180s. Admission/accounted fields are timestamps and derived cost snapshots, not status enums."
    },
    {
      "field": "provider READY/FAILED/DELETED/DELETING/STATE_DELETED; RESOURCE_EXHAUSTED; provider_health; cost/quota status",
      "owner": "provider",
      "disposition": "reference",
      "reason": "Provider lifecycle is external; endpoint_api normalizes responses. Economics/health states are derived observations, not an owned deployment engine."
    },
    {
      "field": "binding_recovery dispatching/in_flight/done; toc_matrix host run/resume/status",
      "owner": "host matrix runner",
      "disposition": "reference",
      "reason": "Binding quarantine consumes host-owned cell input. The public adapter delegates matrix execution; no copied host matrix state machine."
    },
    {
      "field": "hidden_tests status passed/failed/not_run/completed; integrity/taint/locks/baseline/alerting schemas",
      "owner": "tools/paddock",
      "disposition": "derived/configuration",
      "reason": "Verifier subprocess snapshots and taint modes are derived judgments/configuration. Host delivery is delegated. Stateless tool-call, schema and staging helpers own no additional job/agent lifecycle. Existing host/Docker smokes remain manual."
    }
  ],
  "deadEndNotes": [
    "Proposed lifetime/expiry bounds above are not repairs. See each state deadEndEvidence selector."
  ],
  "ownershipNotes": [
    "Snapshots/observations do not transfer ownership from the referenced runtime. Synthetic smoke evidence does not prove live dispatch or provider behavior."
  ],
  "sourceInventory": {
    "endpoint_api.py": [
      "state: 'DELETED'"
    ],
    "taint.py": [
      "GATE_OUTCOMES: frozenset[str] = frozenset({XFAIL_SHADOW, SKIPPED_NO_TAINT_GATE})",
      "outcome: str | None",
      "outcome=None",
      "outcome=SKIPPED_NO_TAINT_GATE",
      "outcome=XFAIL_SHADOW",
      "outcome=decision.outcome or SKIPPED_NO_TAINT_GATE"
    ],
    "standalone.py": [
      "state = subprocess.run([self.docker_bin, 'inspect', '--format={{.State.Running}}', name], env=dict(client_env), capture_output=True, text=True, timeout=_CONTROL_TIMEOUT_SECONDS)",
      "state.returncode != 0",
      "state.returncode == 0",
      "state.stdout.strip() == 'false'",
      "status = 'canceled'",
      "status = 'output_limit_exceeded'",
      "status = 'timeout'",
      "status = None",
      "status is not None",
      "terminal_status=status"
    ],
    "grader.py": [
      "_OK_TERMINAL_STATUSES: frozenset[str] = frozenset({'succeeded', 'completed'})",
      "hidden_result['status'] == 'passed'",
      "outcome == outcomes.PASSED",
      "outcome, reason = (outcomes.FAILED, '; '.join(failed))",
      "outcome, reason = (verdict.outcome, verdict.reason)",
      "outcome: 'error'",
      "outcome: 'not_run'",
      "outcome: str",
      "outcome=outcomes.AGENT_ERROR",
      "outcome=outcomes.FORMAT_FAILED",
      "outcome=outcomes.INTEGRITY_HOLD if flags else verdict.outcome",
      "outcome=outcomes.NO_SUBMISSION",
      "status == 'captured'",
      "terminalStatus: self.terminal_status",
      "terminal_status: str",
      "terminal_status: str | None = None",
      "trajectory.terminal_status not in _OK_TERMINAL_STATUSES"
    ],
    "suite.py": [
      "TIMEOUT_TERMINAL_STATUS = 'timeout'",
      "c.outcome == outcomes.INTEGRITY_HOLD",
      "cell.outcome != outcomes.AGENT_ERROR",
      "cell.outcome = outcomes.AGENT_ERROR",
      "cell.outcome == outcomes.PASSED",
      "cell.terminal_status == 'provider_unavailable'",
      "cell.terminal_status in {TIMEOUT_TERMINAL_STATUS, 'provider_unavailable'}",
      "g.cell.outcome == outcome",
      "g.cell.outcome == outcomes.ERROR",
      "outcome=outcomes.AGENT_ERROR",
      "outcome=outcomes.ERROR",
      "view['terminalStatus'] = cell.terminal_status"
    ],
    "toc_matrix.py": [
      "_STATE_EXHAUSTED = 'exhausted'",
      "state != 'ok'",
      "state = str(row.get('state') or '').lower()",
      "state in ('exhausted', 'suspended')",
      "state: str",
      "statuses = payload.get('providerStatuses')",
      "statuses = selected",
      "str(row.get('state') or '').lower() == _STATE_EXHAUSTED"
    ],
    "doc_checks.py": [
