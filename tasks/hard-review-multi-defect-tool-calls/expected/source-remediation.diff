+def resolve_tool_choice(
+    payload: dict[str, Any], tools: list[dict[str, Any]]
+) -> tuple[str, str | None]:
+    """Keep selection mode separate from the requested function name."""
+    choice = payload.get("tool_choice", "auto")
+    if choice in ("none", "auto", "required"):
+        return choice, None
+    if isinstance(choice, dict) and choice.get("type") == "function":
+        name = (choice.get("function") or {}).get("name")
+        if isinstance(name, str) and name in offered_names(tools):
+            return "named", name
+    raise SupervisorError(
+        "tool_choice must be none, auto, required or an offered function",
+        status=400,
+        kind="INVALID_REQUEST",
+    )
